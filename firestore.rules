rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) &&
        createsOwnedFlat(request.resource.data.activeFlatId);
      allow update: if isSelf(userId) &&
        (!('activeFlatId' in request.resource.data) ||
          isFlatMemberAfter(request.resource.data.activeFlatId));
      allow delete: if false;
    }

    match /flats/{flatId} {
      allow read: if isFlatMember(flatId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isFlatAdmin(flatId);

      match /members/{memberId} {
        allow read: if isFlatMember(flatId);
        allow create: if isFlatAdmin(flatId) ||
          (signedIn() && request.auth.uid == memberId &&
            getAfter(/databases/(default)/documents/flats/$(flatId)).data.createdBy == request.auth.uid &&
            request.resource.data.role == 'admin');
        allow update, delete: if isFlatAdmin(flatId);
      }

      match /expenses/{expenseId} {
        allow read: if isFlatMember(flatId);
        allow create: if isFlatMember(flatId) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.amountInPaise is int &&
          request.resource.data.amountInPaise > 0;
        allow update: if isFlatMember(flatId) &&
          (resource.data.createdBy == request.auth.uid || isFlatAdmin(flatId)) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /settlements/{settlementId} {
        allow read: if isFlatMember(flatId);
        allow create: if isFlatMember(flatId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isFlatMember(flatId) &&
          (resource.data.createdBy == request.auth.uid || isFlatAdmin(flatId));
        allow delete: if false;
      }

      match /invitations/{invitationId} {
        allow read: if isFlatAdmin(flatId);
        allow write: if false;
      }

      match /monthlyStatements/{statementId} {
        allow read: if isFlatMember(flatId);
        allow write: if isFlatAdmin(flatId);
      }
    }
  }

  function signedIn() {
    return request.auth != null;
  }

  function isSelf(userId) {
    return signedIn() && request.auth.uid == userId;
  }

  function isFlatMember(flatId) {
    return signedIn() &&
      exists(/databases/(default)/documents/flats/$(flatId)/members/$(request.auth.uid));
  }

  function isFlatMemberAfter(flatId) {
    return signedIn() &&
      getAfter(/databases/(default)/documents/flats/$(flatId)/members/$(request.auth.uid)).data.uid == request.auth.uid;
  }

  function createsOwnedFlat(flatId) {
    return signedIn() &&
      getAfter(/databases/(default)/documents/flats/$(flatId)).data.createdBy == request.auth.uid &&
      getAfter(/databases/(default)/documents/flats/$(flatId)/members/$(request.auth.uid)).data.role == 'admin';
  }

  function isFlatAdmin(flatId) {
    return isFlatMember(flatId) &&
      get(/databases/(default)/documents/flats/$(flatId)/members/$(request.auth.uid)).data.role == 'admin';
  }
}
